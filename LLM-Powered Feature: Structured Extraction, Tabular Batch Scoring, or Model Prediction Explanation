def score_record(record, temperature=0.0):
    """
    Score a single record using the LLM.
    
    Args:
        record: Dictionary containing transaction data
        temperature: LLM sampling temperature
    
    Returns:
        Tuple of (record, raw_response, validated_result, status)
    """
    record_json = json.dumps(record, indent=2)
    user_prompt = USER_PROMPT_TEMPLATE.format(record_json=record_json)
    
    # Check for PII before calling LLM
    if has_pii(record_json):
        print("Input blocked: PII detected.")
        return record, None, get_fallback_dict(), "blocked"
    
    # Call LLM
    raw_response = call_llm(
        system_prompt=SYSTEM_PROMPT,
        user_prompt=user_prompt,
        temperature=temperature
    )
    
    # Validate response
    validated, status, error = validate_llm_response(raw_response)
    
    return record, raw_response, validated, status


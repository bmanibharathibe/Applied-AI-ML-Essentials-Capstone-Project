# 5. VALIDATION FUNCTION
# =============================================================================

def validate_llm_response(response_text):
    """
    Parse and validate LLM response against the scoring schema.
    
    Args:
        response_text: Raw string response from LLM
    
    Returns:
        Tuple of (parsed_dict, validation_status, error_message)
    """
    if response_text is None:
        return get_fallback_dict(), "fail", "No response from LLM"
    
    # Strip whitespace
    cleaned = response_text.strip()
    
    # Try to parse JSON
    try:
        parsed = json.loads(cleaned)
    except json.JSONDecodeError as e:
        print(f"JSON Parse Error: {e}")
        return get_fallback_dict(), "fail", f"JSONDecodeError: {e}"
    
    # Validate against schema
    try:
        validate(instance=parsed, schema=SCORING_SCHEMA)
        return parsed, "pass", None
    except ValidationError as e:
        print(f"Validation Error: {e.message}")
        return get_fallback_dict(), "fail", f"ValidationError: {e.message}"

def get_fallback_dict():
    """Return fallback dict with all required fields set to null."""
    return {
        "risk_tier": None,
        "flag_for_review": None,
        "primary_signal": None,
        "confidence": None,
        "recommended_action": None
    }

